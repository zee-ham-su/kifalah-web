# Postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kifalah
PAYLOAD_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Paystack (test keys first: sk_test_...)
PAYSTACK_SECRET_KEY=

# Cloudflare R2 (leave blank in dev to store uploads on local disk)
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Receipts: email via Resend, SMS via Hubtel (all optional in dev; sending is skipped if blank)
RESEND_API_KEY=
EMAIL_FROM=
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=
