# --- Required ---
DATABASE_URL=postgresql://user:password@host:5432/dbname
PORT=5000
BASE_PATH=/

# Clerk (admin sign-in). Server and browser keys come from the same Clerk app.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# Who may use the admin area: comma-separated, VERIFIED emails. Empty = nobody (fail closed).
# Also switch OFF "Sign-up" in the Clerk dashboard so strangers cannot create accounts.
ADMIN_EMAILS=

# --- Optional ---
# Email alert to staff on every form submission (via Resend). All three needed, else skipped.
RESEND_API_KEY=
EMAIL_FROM=
NOTIFY_EMAIL=

# Cross-origin access to the API. Leave empty when the site and API share one origin (the default).
CORS_ORIGINS=

# Submissions allowed per IP per 15 minutes across all public forms (default 10).
FORM_RATE_LIMIT=
